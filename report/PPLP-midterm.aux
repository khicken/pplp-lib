\newlabel{fig:graph-union}{{2}{3}{Two-party graph union. Alice's graph $G_A$ (left) and Bob's graph $G_B$ (center) share overlapping node set $\{A,B,C,D,E\}$; their union (right) contains additional nodes $G$, $H$ from Alice and $K$, $F$ from Bob}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Applying PSI for candidate pair $(A,E)$. Alice and Bob first compute local intersections $I_A$ and $I_B$ independently. Three PSI calls then privately resolve the crossover terms: $I_A \cap I_B = \{C\}$, $N_A(A\text  {-}E) \cap N_B(E\text  {-}A) = \{B\}$, and $N_A(E\text  {-}A) \cap N_B(A\text  {-}E) = \emptyset $.}}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:applying-psi}{{3}{3}{Applying PSI for candidate pair $(A,E)$. Alice and Bob first compute local intersections $I_A$ and $I_B$ independently. Three PSI calls then privately resolve the crossover terms: $I_A \cap I_B = \{C\}$, $N_A(A\text {-}E) \cap N_B(E\text {-}A) = \{B\}$, and $N_A(E\text {-}A) \cap N_B(A\text {-}E) = \emptyset $}{figure.caption.6}{}}
