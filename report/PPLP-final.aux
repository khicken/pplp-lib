\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Two-party graph union. Alice's graph $G_A$ (left) and Bob's graph $G_B$ (center) share overlapping node set $\{A,B,C,D,E\}$; their union (right) contains additional nodes $G$, $H$ from Alice and $K$, $F$ from Bob.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:graph-union}{{2}{4}{Two-party graph union. Alice's graph $G_A$ (left) and Bob's graph $G_B$ (center) share overlapping node set $\{A,B,C,D,E\}$; their union (right) contains additional nodes $G$, $H$ from Alice and $K$, $F$ from Bob}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Applying PSI for candidate pair $(A,E)$. Alice and Bob first compute local intersections $I_A$ and $I_B$ independently. Three PSI calls then privately resolve the crossover terms: $I_A \cap I_B = \{C\}$, $N_A(A\text  {-}E) \cap N_B(E\text  {-}A) = \{B\}$, and $N_A(E\text  {-}A) \cap N_B(A\text  {-}E) = \emptyset $.}}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:applying-psi}{{3}{4}{Applying PSI for candidate pair $(A,E)$. Alice and Bob first compute local intersections $I_A$ and $I_B$ independently. Three PSI calls then privately resolve the crossover terms: $I_A \cap I_B = \{C\}$, $N_A(A\text {-}E) \cap N_B(E\text {-}A) = \{B\}$, and $N_A(E\text {-}A) \cap N_B(A\text {-}E) = \emptyset $}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Computing $|\text  {CN}(A,E)|$. Combining local terms $|I_A|{=}1$ and $|I_B|{=}2$ with the PSI-computed crossover results yields $|\text  {CN}(A,E)| = 1 + 2 - 1 + 1 + 0 = 3$.}}{5}{figure.caption.8}\protected@file@percent }
\newlabel{fig:cn-result}{{4}{5}{Computing $|\text {CN}(A,E)|$. Combining local terms $|I_A|{=}1$ and $|I_B|{=}2$ with the PSI-computed crossover results yields $|\text {CN}(A,E)| = 1 + 2 - 1 + 1 + 0 = 3$}{figure.caption.8}{}}
